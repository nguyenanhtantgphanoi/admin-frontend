<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Push Notification</title>
  <style>
    :root {
      --primary: #2563eb;
      --primary-dark: #1d4ed8;
      --bg: #f3f4f6;
      --card: #ffffff;
      --muted: #6b7280;
      --border: #d1d5db;
      --success: #16a34a;
      --danger: #dc2626;
      --warning: #f59e0b;
      --shadow: 0 12px 30px rgba(15, 23, 42, 0.1);
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: linear-gradient(135deg, #eef2ff 0%, #f8fafc 100%);
      color: #111827;
    }

    .container {
      max-width: 1100px;
      margin: 40px auto;
      padding: 0 20px;
    }

    .card {
      background: var(--card);
      border-radius: 18px;
      box-shadow: var(--shadow);
      border: 1px solid rgba(148, 163, 184, 0.2);
      overflow: hidden;
    }

    .header {
      background: linear-gradient(90deg, var(--primary) 0%, #7c3aed 100%);
      padding: 26px 30px;
      color: white;
    }

    .header h1 {
      margin: 0;
      font-size: 2rem;
    }

    .header p {
      margin: 8px 0 0;
      opacity: 0.9;
      font-size: 0.96rem;
    }

    .body {
      padding: 30px;
    }

    .grid {
      display: grid;
      grid-template-columns: 1.15fr 1fr;
      gap: 24px;
    }

    label {
      display: block;
      font-weight: 700;
      font-size: 0.95rem;
      margin-bottom: 8px;
      color: #374151;
    }

    input, textarea, select, button {
      font: inherit;
    }

    input, textarea, select {
      width: 100%;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 12px 14px;
      background: #fff;
      color: #111827;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    input:focus, textarea:focus, select:focus {
      outline: none;
      border-color: rgba(37, 99, 235, 0.7);
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
    }

    textarea {
      min-height: 120px;
      resize: vertical;
    }

    .field {
      margin-bottom: 20px;
    }

    .inline-row {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .target-box {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 14px;
      padding: 18px;
    }

    .radio-row {
      display: flex;
      gap: 16px;
      margin-top: 8px;
    }

    .radio-option {
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 600;
      color: #374151;
    }

    .radio-option input {
      width: auto;
      margin: 0;
    }

    .btn {
      border: none;
      border-radius: 12px;
      padding: 14px 18px;
      font-weight: 700;
      cursor: pointer;
      transition: transform 0.15s ease, opacity 0.2s ease;
    }

    .btn:hover {
      transform: translateY(-1px);
    }

    .btn-primary {
      background: linear-gradient(90deg, var(--primary) 0%, #7c3aed 100%);
      color: white;
      width: 100%;
      margin-top: 12px;
    }

    .btn-secondary {
      background: #e5e7eb;
      color: #111827;
    }

    .btn-danger {
      background: var(--danger);
      color: white;
    }

    .result-box {
      margin-top: 24px;
      border: 1px solid #dbeafe;
      background: #eff6ff;
      border-radius: 14px;
      overflow: hidden;
      display: none;
    }

    .result-box.visible {
      display: block;
    }

    .result-header {
      background: #dbeafe;
      padding: 12px 18px;
      font-weight: 700;
      color: #1d4ed8;
    }

    .result-body {
      padding: 16px 18px;
      max-height: 420px;
      overflow: auto;
    }

    pre {
      white-space: pre-wrap;
      word-break: break-word;
      margin: 0;
      color: #0f172a;
      font-size: 0.9rem;
      line-height: 1.6;
    }

    .modal {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.5);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 999;
      padding: 20px;
    }

    .modal.visible {
      display: flex;
    }

    .modal-content {
      background: white;
      border-radius: 18px;
      width: min(560px, 100%);
      box-shadow: 0 25px 50px rgba(15, 23, 42, 0.2);
      overflow: hidden;
    }

    .modal-header {
      padding: 18px 22px;
      border-bottom: 1px solid #e5e7eb;
      background: #f8fafc;
      font-weight: 700;
      color: #111827;
    }

    .modal-body {
      padding: 18px 22px;
      color: #374151;
      line-height: 1.6;
    }

    .modal-footer {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      padding: 18px 22px 22px;
    }

    @media (max-width: 800px) {
      .grid,
      .inline-row {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="card">
      <div class="header">
        <h1>🔔 Push Notification</h1>
        <p>Gửi thông báo tới tất cả thiết bị hoặc danh sách token cụ thể</p>
      </div>

      <div class="body">
        <div class="grid">
          <div>
            <div class="field">
              <label for="title">Title</label>
              <input id="title" type="text" placeholder="Nhập tiêu đề thông báo" />
            </div>

            <div class="field">
              <label for="body">Body</label>
              <textarea id="body" placeholder="Nhập nội dung thông báo"></textarea>
            </div>
          </div>

          <div>
            <div class="target-box">
              <div class="field">
                <label>Data</label>
                <div class="inline-row">
                  <div>
                    <label for="screen">screen</label>
                    <input id="screen" type="text" placeholder="Ví dụ: Home" />
                  </div>
                  <div>
                    <label for="type">type</label>
                    <input id="type" type="text" placeholder="Ví dụ: mass-readings" />
                  </div>
                </div>
              </div>

              <div class="field">
                <div class="inline-row">
                  <div>
                    <label for="dateKey">dateKey</label>
                    <input id="dateKey" type="date" />
                  </div>
                  <div>
                    <label for="date">date</label>
                    <input id="date" type="date" />
                  </div>
                </div>
              </div>

              <div class="field">
                <label for="os">os</label>
                <input id="os" type="text" value="all" />
              </div>
            </div>

            <div class="field" style="margin-top: 18px;">
              <label>Target</label>
              <div class="radio-row">
                <label class="radio-option">
                  <input type="radio" name="target" value="all" checked />
                  Gửi tất cả
                </label>
                <label class="radio-option">
                  <input type="radio" name="target" value="tokens" />
                  Gửi theo token
                </label>
              </div>
            </div>

            <div class="field" id="tokensField" style="display: none;">
              <label for="tokens">Tokens</label>
              <textarea id="tokens" placeholder="Mỗi token trên 1 dòng hoặc nhập dạng JSON array"></textarea>
            </div>
          </div>
        </div>

        <button class="btn btn-primary" id="openModalBtn" type="button">Push Notification</button>
      </div>
    </div>

    <div class="result-box" id="resultBox">
      <div class="result-header">Kết quả trả về</div>
      <div class="result-body">
        <pre id="resultOutput">{}</pre>
      </div>
    </div>
  </div>

  <div class="modal" id="confirmModal" aria-hidden="true">
    <div class="modal-content" role="dialog" aria-modal="true" aria-labelledby="confirmTitle">
      <div class="modal-header" id="confirmTitle">Xác nhận gửi thông báo</div>
      <div class="modal-body" id="confirmBody"></div>
      <div class="modal-footer">
        <button class="btn btn-secondary" type="button" id="cancelConfirmBtn">Hủy</button>
        <button class="btn btn-danger" type="button" id="confirmPushBtn">Xác nhận push</button>
      </div>
    </div>
  </div>

  <script>
    const titleInput = document.getElementById('title')
    const bodyInput = document.getElementById('body')
    const screenInput = document.getElementById('screen')
    const typeInput = document.getElementById('type')
    const dateKeyInput = document.getElementById('dateKey')
    const dateInput = document.getElementById('date')
    const osInput = document.getElementById('os')
    const tokensInput = document.getElementById('tokens')
    const tokensField = document.getElementById('tokensField')
    const resultBox = document.getElementById('resultBox')
    const resultOutput = document.getElementById('resultOutput')
    const confirmModal = document.getElementById('confirmModal')
    const confirmBody = document.getElementById('confirmBody')

    function getTargetMode() {
      return document.querySelector('input[name="target"]:checked').value
    }

    function parseTokens(value) {
      const trimmed = value.trim()
      if (!trimmed) return []

      try {
        const parsed = JSON.parse(trimmed)
        if (Array.isArray(parsed)) return parsed.filter(Boolean)
      } catch (error) {
      }

      return trimmed
        .split(/\r?\n|,/)
        .map((token) => token.trim())
        .filter(Boolean)
    }

    function buildPayload() {
      const title = titleInput.value.trim()
      const body = bodyInput.value.trim()
      const target = getTargetMode()
      const dateRegex = /^\d{4}-\d{2}-\d{2}$/
      const normalizedDateKey = dateRegex.test(dateKeyInput.value.trim()) ? dateKeyInput.value.trim() : null
      const normalizedDate = dateRegex.test(dateInput.value.trim()) ? dateInput.value.trim() : null
      const data = {
        screen: screenInput.value.trim(),
        type: typeInput.value.trim(),
        dateKey: normalizedDateKey,
        date: normalizedDate,
        os: osInput.value.trim() || 'all'
      }

      const payload = { title, body, data }

      if (target === 'tokens') {
        payload.tokens = parseTokens(tokensInput.value)
      }

      return payload
    }

    function showResult(data) {
      resultBox.classList.add('visible')
      resultOutput.textContent = JSON.stringify(data, null, 2)
    }

    function openModal() {
      const payload = buildPayload()
      const isTargetTokens = getTargetMode() === 'tokens'
      const tokensText = isTargetTokens ? `\nTokens: ${JSON.stringify(payload.tokens)}` : ''

      if (!payload.title || !payload.body) {
        alert('Vui lòng nhập Title và Body')
        return
      }

      if (isTargetTokens && (!payload.tokens || payload.tokens.length === 0)) {
        alert('Vui lòng nhập tối thiểu 1 token hoặc danh sách token hợp lệ')
        return
      }

      confirmBody.innerHTML = `
        <strong>Title:</strong> ${payload.title}<br>
        <strong>Body:</strong> ${payload.body}<br>
        <strong>Target:</strong> ${isTargetTokens ? 'Specific tokens' : 'All devices'}${tokensText}<br>
        <strong>Data:</strong><br>
        <pre>${JSON.stringify(payload.data, null, 2)}</pre>
      `
      confirmModal.classList.add('visible')
    }

    function closeModal() {
      confirmModal.classList.remove('visible')
    }

    document.querySelectorAll('input[name="target"]').forEach((radio) => {
      radio.addEventListener('change', function () {
        tokensField.style.display = this.value === 'tokens' ? 'block' : 'none'
      })
    })

    document.getElementById('openModalBtn').addEventListener('click', openModal)
    document.getElementById('cancelConfirmBtn').addEventListener('click', closeModal)
    document.getElementById('confirmPushBtn').addEventListener('click', async function () {
      const payload = buildPayload()
      closeModal()

      try {
        const response = await fetch('/push-notif', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        })

        const responseText = await response.text()
        let responseJson = responseText

        try {
          responseJson = JSON.parse(responseText)
        } catch (error) {
          responseJson = responseText
        }

        if (!response.ok) {
          showResult({ error: true, status: response.status, body: responseJson })
          return
        }

        showResult({ status: response.status, data: responseJson })
      } catch (error) {
        showResult({ error: true, message: error.message })
      }
    })
  </script>
</body>
</html>
