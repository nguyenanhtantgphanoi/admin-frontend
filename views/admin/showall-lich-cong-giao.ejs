<script>
    $(document).ready(function(){
        const showAllLichStorageKey = 'showall-lich-start-date';

        const richTextFields = [
            { editor: '#under-title-editor', field: '#under-title' },
            { editor: '#luu-y-editor', field: '#luu-y' },
            { editor: '#sunday-catechism-editor', field: '#sunday_catechism' }
        ];
        function cleanEditorHtml(html) {
            const doc = new DOMParser().parseFromString(html || '', 'text/html');
            const allowedTags = new Set(['A', 'B', 'I', 'U', 'STRONG', 'EM', 'FONT', 'SPAN', 'DIV', 'P', 'BR']);
            const cleanInlineStyle = (styleText) => styleText.split(';').map(declaration => {
                const separator = declaration.indexOf(':');
                if (separator < 1) return '';
                const property = declaration.slice(0, separator).trim();
                const value = declaration.slice(separator + 1).trim();
                if (property.toLowerCase() === 'font-size') return '';
                const safeProperty = /^-?[a-z][a-z0-9-]*$/i.test(property) && !/^(behavior|-moz-binding)$/i.test(property);
                const safeValue = value && !/[<>]/.test(value) && !/(url\s*\(|expression\s*\(|javascript:|@import)/i.test(value);
                return safeProperty && safeValue ? `${property}: ${value}` : '';
            }).filter(Boolean).join('; ');
            const cleanNode = (node) => {
                Array.from(node.children || []).forEach(child => {
                    cleanNode(child);
                    if (!allowedTags.has(child.tagName)) {
                        child.replaceWith(...child.childNodes);
                        return;
                    }
                    if (child.hasAttribute('style')) {
                        const safeStyle = cleanInlineStyle(child.getAttribute('style'));
                        if (safeStyle) child.setAttribute('style', safeStyle);
                        else child.removeAttribute('style');
                    }
                    Array.from(child.attributes).forEach(attr => {
                        const safeLink = child.tagName === 'A' && attr.name === 'href' && /^(https?:|mailto:|tel:|\/|#|\.?\.?\/)/i.test(attr.value.trim());
                        const allowed = safeLink || (child.tagName === 'FONT' && ['face', 'size', 'color'].includes(attr.name)) ||
                            (attr.name === 'style' && ['SPAN', 'P', 'DIV', 'A'].includes(child.tagName));
                        if (!allowed) child.removeAttribute(attr.name);
                    });
                });
            };
            cleanNode(doc.body);
            if (!doc.body.textContent.trim()) return '';
            return doc.body.innerHTML;
        }
        function setEditorValue(editorSelector, value) {
            const editor = $(editorSelector).get(0);
            const fieldSelector = richTextFields.find(item => item.editor === editorSelector).field;
            $(fieldSelector).addClass('d-none').data('html-mode', false);
            $(`.editor-mode-toggle[data-editor="${editorSelector}"]`).text('Sửa HTML');
            $(editorSelector).removeClass('d-none');
            const text = value || '';
            editor.innerHTML = !text
                ? ''
                : /<\/?(?:a|b|i|u|strong|em|font|span|div|p|br)\b/i.test(text)
                    ? cleanEditorHtml(text)
                    : text.split(/\r?\n/).map(line => `<p>${$('<div>').text(line).html() || '<br>'}</p>`).join('');
            $(editorSelector).trigger('input');
        }
        richTextFields.forEach(({ editor, field }) => {
            let editorSelectionRange = null;
            const editorElement = $(editor).get(0);
            document.addEventListener('selectionchange', function() {
                const selection = window.getSelection();
                if (selection && !selection.isCollapsed && selection.rangeCount > 0 &&
                    editorElement.contains(selection.getRangeAt(0).commonAncestorContainer)) {
                    editorSelectionRange = selection.getRangeAt(0).cloneRange();
                }
            });
            $(editor).on('input', function() { $(field).val(cleanEditorHtml(this.innerHTML)); });
            $(editor).closest('.mb-3').find('.editor-command').on('mousedown', function(event) {
                event.preventDefault();
                $(editor).trigger('focus');
                document.execCommand($(this).data('command'), false, null);
                $(editor).trigger('input');
            });
            $(editor).closest('.mb-3').find('.editor-font-family').on('change', function() {
                $(editor).trigger('focus');
                document.execCommand('fontName', false, this.value);
                $(editor).trigger('input');
            });
            $(editor).closest('.mb-3').find('.editor-font-size').on('change', function() {
                $(editor).trigger('focus');
                document.execCommand('fontSize', false, this.value);
                $(editor).trigger('input');
            });
            $(editor).closest('.mb-3').find('.editor-font-color').on('input', function() {
                $(editor).trigger('focus');
                document.execCommand('foreColor', false, this.value);
                $(editor).trigger('input');
            });
            const linkContainer = $(editor).closest('.mb-3');
            linkContainer.find('.editor-link').on('mousedown', function(event) {
                event.preventDefault();
                const selection = window.getSelection();
                if (selection && !selection.isCollapsed && selection.rangeCount > 0 &&
                    editorElement.contains(selection.getRangeAt(0).commonAncestorContainer)) {
                    editorSelectionRange = selection.getRangeAt(0).cloneRange();
                }
            }).on('click', function() {
                if (!editorSelectionRange) {
                    alert('Hãy bôi đen đoạn chữ cần gán liên kết trước.');
                    return;
                }
                linkContainer.find('.editor-link-input').removeClass('d-none').find('input').val('').trigger('focus');
            });
            linkContainer.find('.editor-link-confirm').on('click', function() {
                const url = linkContainer.find('.editor-link-input input').val().trim();
                if (!url || !editorSelectionRange) return;
                const selection = window.getSelection();
                $(editor).trigger('focus');
                selection.removeAllRanges();
                selection.addRange(editorSelectionRange);
                document.execCommand('createLink', false, url);
                editorSelectionRange = null;
                linkContainer.find('.editor-link-input').addClass('d-none');
                $(editor).trigger('input');
            });
            linkContainer.find('.apply-paragraph-border').on('mousedown', function(event) {
                event.preventDefault();
                const selection = window.getSelection();
                if (selection && !selection.isCollapsed && selection.rangeCount > 0 &&
                    editorElement.contains(selection.getRangeAt(0).commonAncestorContainer)) {
                    editorSelectionRange = selection.getRangeAt(0).cloneRange();
                }
            }).on('click', function() {
                if (!editorSelectionRange || editorSelectionRange.collapsed) {
                    alert('Hãy bôi đen paragraph cần tạo viền trước.');
                    return;
                }
                const range = editorSelectionRange;
                const intersects = (element) => {
                    try { return range.intersectsNode(element); } catch (err) { return false; }
                };
                const paragraphs = Array.from(editorElement.querySelectorAll('p')).filter(intersects);
                const blocks = paragraphs.length
                    ? paragraphs
                    : Array.from(editorElement.querySelectorAll('div')).filter(element => intersects(element) &&
                        !Array.from(element.querySelectorAll('div')).some(intersects));
                if (!blocks.length) {
                    alert('Đoạn được chọn chưa nằm trong paragraph. Hãy tạo paragraph bằng phím Enter rồi thử lại.');
                    return;
                }
                const borderStyle = linkContainer.find('.paragraph-border-style').val();
                const padding = Math.max(0, Math.min(100, Number(linkContainer.find('.paragraph-border-padding').val()) || 0));
                blocks.forEach(block => {
                    block.style.borderStyle = borderStyle;
                    block.style.borderWidth = borderStyle === 'none' || borderStyle === 'hidden' ? '0' : '1px';
                    block.style.borderColor = '#555';
                    block.style.padding = `${padding}px`;
                });
                editorSelectionRange = null;
                $(editor).trigger('input');
            });
        });
        $('.editor-mode-toggle').on('click', function() {
            const editor = $($(this).data('editor'));
            const field = $($(this).data('field'));
            if (!field.data('html-mode')) {
                field.val(cleanEditorHtml(editor.html())).removeClass('d-none').data('html-mode', true).trigger('focus');
                editor.addClass('d-none');
                $(this).text('Sửa nội dung');
            } else {
                editor.html(cleanEditorHtml(field.val()));
                field.data('html-mode', false).addClass('d-none');
                editor.removeClass('d-none').trigger('input').trigger('focus');
                $(this).text('Sửa HTML');
            }
        });

        function applyShowAllLichFilter() {
            const selectedDate = $('#showall-lich-start-date').val();

            if (selectedDate) {
                localStorage.setItem(showAllLichStorageKey, selectedDate);
            } else {
                localStorage.removeItem(showAllLichStorageKey);
            }

            const url = new URL(window.location.href);
            if (selectedDate) {
                url.searchParams.set('fromDate', selectedDate);
            } else {
                url.searchParams.delete('fromDate');
            }

            window.location.href = url.toString();
        }

        function clearShowAllLichFilter() {
            $('#showall-lich-start-date').val('');
            localStorage.removeItem(showAllLichStorageKey);
            const url = new URL(window.location.href);
            url.searchParams.delete('fromDate');
            window.location.href = url.toString();
        }

